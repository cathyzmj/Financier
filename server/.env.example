# Financier backend — environment variables
# Copy this file to ".env" and fill in real values. The real .env is gitignored.

# ---- Access control -------------------------------------------------------
# The password for the login screen. REQUIRED before the app can be reached from
# any device other than this one: the server refuses to start on a non-loopback
# address without it. Use a long passphrase — this is the only thing between the
# internet-adjacent world and your holdings, transactions and account references.
FINANCIER_PASSWORD=

# Bind address. 127.0.0.1 (default) = this machine only.
# 0.0.0.0 = reachable over your network / Tailscale. Needs FINANCIER_PASSWORD.
# FINANCIER_HOST=0.0.0.0

# FINANCIER_PORT=8000

# ---- AI decision review ---------------------------------------------------
# Anthropic API key for the Journal's "Review decisions" / "Style profile".
# Optional — you can instead paste the key into the UI (stored in that browser only).
ANTHROPIC_API_KEY=

# ---- Broker imports (optional) -------------------------------------------
# Usually entered in the UI instead; these are fallbacks.
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=
# T212_API_KEY=

# ---- Network --------------------------------------------------------------
# Force outbound calls through a proxy (mainland China). Auto-detected on macOS.
# IBKR_FLEX_PROXY=127.0.0.1:7897
